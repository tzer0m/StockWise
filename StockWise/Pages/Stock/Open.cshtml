@page "{id:int}"
@model StockWise.Pages.Stock.OpenModel
@{
    ViewData["Title"] = "Open item";
}

<h1>Open @Model.Stock?.Item?.Name</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="LocationId" class="form-label">New location</label>
        <select asp-for="LocationId" class="form-select" data-expiry-target="Expiry">
            <option value="">-- Select a location --</option>
            @foreach (StockWise.Models.Location location in Model.AllowedLocations)
            {
                <option value="@location.LocationId" data-category="@location.Category?.Name">@location.Category?.Name - @location.Name</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Expiry" class="form-label">New expiry</label>
        <input asp-for="Expiry" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Open</button>
    <a asp-page="/Index" class="btn btn-link">Cancel</a>
</form>