@page
@model StockWise.Pages.Stock.AddModel
@{
    ViewData["Title"] = "Add Stock";
}

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Barcode) && Model.Item is null)
{
    <div class="alert alert-warning">
        No item found for barcode "@Model.Barcode".
        <a asp-page="/Manage/Items/Add" asp-route-barcode="@Model.Barcode">Add It</a>
    </div>
}

@if (Model.Item is not null)
{
    <h2 class="mb-1">@Model.ItemTitle</h2>
    <div class="h6 text-muted mb-4">@Model.Barcode</div>

    <form method="post" asp-page-handler="AddStock">
        <input type="hidden" asp-for="Barcode" />
        <input type="hidden" name="itemId" value="@Model.Item.ItemId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="form-row">
            <label asp-for="LocationId" class="form-label">Location</label>
            <div class="form-row-control">
                <select asp-for="LocationId" class="form-select" data-expiry-target="Expiry" required>
                    <option value="">-- Select a location --</option>
                    @foreach (StockWise.Models.Location location in Model.AllowedLocations)
                    {
                        <option value="@location.LocationId" data-category="@location.Category?.Name">@location.Category?.Name - @location.Name</option>
                    }
                </select>
                <span asp-validation-for="LocationId" class="field-validation-error"></span>
            </div>
        </div>
        <div class="form-row">
            <label asp-for="Quantity" class="form-label">Quantity</label>
            <div class="form-row-control">
                <input asp-for="Quantity" class="form-control" type="number" min="1" required />
                <span asp-validation-for="Quantity" class="field-validation-error"></span>
            </div>
        </div>
        <div class="form-row">
            <label asp-for="Expiry" class="form-label">Expiry</label>
            <div class="form-row-control">
                <input asp-for="Expiry" class="form-control" type="date" />
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Add Stock</button>
    </form>
}
