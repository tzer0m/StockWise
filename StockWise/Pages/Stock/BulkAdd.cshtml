@page
@model StockWise.Pages.Stock.BulkAddModel
@{
    ViewData["Title"] = "Bulk Add Stock";
}

@if (string.IsNullOrWhiteSpace(Model.Batch))
{
    <div class="mb-3">
        <input id="bulkBarcodeInput" class="form-control" autofocus autocomplete="off" placeholder="Scan a barcode..." />
    </div>

    <ul id="bulkScanList" class="list-group mb-3"></ul>

    <form method="get">
        <input type="hidden" name="batch" id="bulkBatchInput" />
        <button type="submit" class="btn btn-primary" id="bulkReviewButton" disabled>Review & Add</button>
    </form>

    <script type="application/json" id="bulkItemLookup">@Html.Raw(Model.ItemLookupJson)</script>
}
else
{
    <p class="text-muted">@Model.RemainingCount item@(Model.RemainingCount == 1 ? "" : "s") remaining.</p>

    @if (Model.Item is not null)
    {
        <h2 class="h4">@Model.Item.Name</h2>

        <form method="post" asp-page-handler="AddStock" id="bulkStockForm">
            <input type="hidden" asp-for="Batch" />
            <input type="hidden" name="itemId" value="@Model.Item.ItemId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="form-row">
                <label asp-for="LocationId" class="form-label">Location</label>
                <div class="form-row-control">
                    <select asp-for="LocationId" class="form-select" data-expiry-target="Expiry" required>
                        <option value="">-- Select a location --</option>
                        @foreach (StockWise.Models.Location location in Model.AllowedLocations)
                        {
                            <option value="@location.LocationId" data-category="@location.Category?.Name">@location.Category?.Name - @location.Name</option>
                        }
                    </select>
                    <span asp-validation-for="LocationId" class="field-validation-error"></span>
                </div>
            </div>
            <div class="form-row">
                <label asp-for="Quantity" class="form-label">Quantity</label>
                <div class="form-row-control">
                    <input asp-for="Quantity" class="form-control" type="number" min="1" required />
                    <span asp-validation-for="Quantity" class="field-validation-error"></span>
                </div>
            </div>
            <div class="form-row">
                <label asp-for="Expiry" class="form-label">Expiry</label>
                <div class="form-row-control">
                    <input asp-for="Expiry" class="form-control" type="date" />
                </div>
            </div>
        </form>

        <div class="d-flex gap-2 mt-3">
            <button type="button" class="btn btn-primary flex-fill" onclick="document.getElementById('bulkStockForm').requestSubmit();">Add Stock</button>
            <button type="button" class="btn btn-outline-secondary flex-fill" onclick="document.getElementById('bulkSkipForm').requestSubmit();">Skip</button>
        </div>
    }
    else
    {
        <div class="alert alert-warning">No item found for barcode "@Model.CurrentBarcode".</div>

        <form method="post" asp-page-handler="AddItem" id="bulkItemForm">
            <input type="hidden" asp-for="Batch" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            @{ ViewData["BarcodeReadOnly"] = true; }
            <partial name="_ItemForm" for="NewItem" />
        </form>

        <div class="d-flex gap-2 mt-3">
            <button type="button" class="btn btn-primary flex-fill" onclick="document.getElementById('bulkItemForm').requestSubmit();">Continue</button>
            <button type="button" class="btn btn-outline-secondary flex-fill" onclick="document.getElementById('bulkSkipForm').requestSubmit();">Skip</button>
        </div>
    }

    <form method="post" asp-page-handler="Skip" id="bulkSkipForm">
        <input type="hidden" asp-for="Batch" />
    </form>
}