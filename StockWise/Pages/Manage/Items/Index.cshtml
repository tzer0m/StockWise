@page
@model StockWise.Pages.Manage.Items.IndexModel
@{
    ViewData["Title"] = "Items";
}

<form method="get" class="mb-4">
    <div class="mb-3">
        <input type="text" name="Barcode" class="form-control" autofocus autocomplete="off" placeholder="Scan a barcode..." />
    </div>
</form>

@if (Model.ItemAlreadyExists)
{
    <div class="alert alert-warning">Item already exists.</div>
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Items.Count == 0)
{
    <p>No items yet.</p>
}
else
{
    <table class="table table-cards">
        <thead>
            <tr>
                <th><a asp-page="Index" asp-route-sort="name" asp-route-direction="@(Model.Sort == "name" && Model.Direction == "asc" ? "desc" : "asc")" class="text-decoration-none">Name@(Model.Sort == "name" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a asp-page="Index" asp-route-sort="brand" asp-route-direction="@(Model.Sort == "brand" && Model.Direction == "asc" ? "desc" : "asc")" class="text-decoration-none">Brand@(Model.Sort == "brand" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a asp-page="Index" asp-route-sort="barcode" asp-route-direction="@(Model.Sort == "barcode" && Model.Direction == "asc" ? "desc" : "asc")" class="text-decoration-none">Barcode@(Model.Sort == "barcode" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a asp-page="Index" asp-route-sort="openable" asp-route-direction="@(Model.Sort == "openable" && Model.Direction == "asc" ? "desc" : "asc")" class="text-decoration-none">Openable@(Model.Sort == "openable" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (StockWise.Models.Item item in Model.Items)
            {
                <tr>
                    <td class="cell-heading">@item.Name</td>
                    <td data-label="Brand">@item.Brand</td>
                    <td data-label="Barcode">@item.Barcode</td>
                    <td data-label="Openable">
                        @if (item.IsOpenable)
                        {
                            <span class="tile tile-green tile-icon"><partial name="_Icon" model="@("check-lg")" /></span>
                        }
                        else
                        {
                            <span class="tile tile-red tile-icon"><partial name="_Icon" model="@("x-lg")" /></span>
                        }
                    </td>
                    <td class="action-cell">
                        <a asp-page="Edit" asp-route-id="@item.ItemId" class="btn-icon" title="Edit" aria-label="Edit"><partial name="_Icon" model="@("pencil")" /></a>
                        @if (!Model.ItemIdsWithStock.Contains(item.ItemId))
                        {
                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.ItemId" class="d-inline" onsubmit="return confirm('Delete this item?');">
                                <button type="submit" class="btn-icon" title="Delete" aria-label="Delete"><partial name="_Icon" model="@("x-lg")" /></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}