@page
@model StockWise.Pages.Manage.Items.IndexModel
@{
    ViewData["Title"] = "Items";
}

<h1>Items</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="mb-3">
    <a asp-page="Add" class="btn btn-primary">Add item</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Barcode</th>
            <th>Name</th>
            <th>Brand</th>
            <th>Can be opened</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (StockWise.Models.Item item in Model.Items)
        {
            <tr>
                <td>@item.Barcode</td>
                <td>@item.Name</td>
                <td>@item.Brand</td>
                <td>@(item.IsOpenable ? "Yes" : "No")</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@item.ItemId">Edit</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.ItemId" class="d-inline" onsubmit="return confirm('Delete this item?');">
                        <button type="submit" class="btn btn-link text-danger p-0 ms-2">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>