@page "{id:int}"
@model StockWise.Pages.Manage.Locations.EditModel
@{
    ViewData["Title"] = "Edit Location";
}

<form method="post">
    <input type="hidden" asp-for="Location.LocationId" />
    <div class="d-flex gap-2 mb-3">
        <select asp-for="Location.CategoryId" class="form-select" asp-items="Model.CategoryOptions"></select>
        <input asp-for="Location.Name" class="form-control flex-grow-1" autocapitalize="words" placeholder="Name" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
</form>