@page "{id:int}"
@model StockWise.Pages.Manage.Categories.EditModel
@{
    ViewData["Title"] = "Edit Category";
}

<form method="post">
    <input type="hidden" asp-for="Category.CategoryId" />
    <div class="d-flex gap-2 mb-3">
        <input asp-for="Category.Color" type="color" class="form-control form-control-color" value="@(Model.Category.Color ?? "#6c757d")" title="Colour" />
        <input asp-for="Category.Name" class="form-control flex-grow-1" autocapitalize="words" placeholder="Name" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
</form>