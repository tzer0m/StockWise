@page "{id:int}"
@model StockWise.Pages.Manage.Categories.EditModel
@{
    ViewData["Title"] = "Edit Category";
}

<h1>Edit Category</h1>

<form method="post">
    <input type="hidden" asp-for="Category.CategoryId" />
    <div class="mb-3">
        <label asp-for="Category.Name" class="form-label">Name</label>
        <input asp-for="Category.Name" class="form-control" autocapitalize="words" />
    </div>
    <div class="mb-3">
        <label asp-for="Category.Color" class="form-label">Colour</label>
        <input asp-for="Category.Color" type="color" class="form-control form-control-color" value="@(Model.Category.Color ?? "#6c757d")" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-link">Cancel</a>
</form>