@page
@using StockWise.Models
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<form method="get" class="mb-4">
    <div class="mb-3">
        <input type="text" name="Barcode" class="form-control" autofocus autocomplete="off" placeholder="Scan a barcode..." />
    </div>
</form>

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Barcode))
{
    @if (Model.ScannedItem is null && Model.ScannedMealInstance is null)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            "@Model.Barcode" not found.
            <a asp-page="/Manage/Items/Add" asp-route-barcode="@Model.Barcode" class="btn btn-primary btn-sm">Add</a>
        </div>
    }
    else if (Model.ScannedMealInstance is not null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h4 mb-0">@Model.ScannedMealInstance.Meal?.Name</h2>
                    <form method="post" asp-page-handler="Eat" asp-route-mealInstanceId="@Model.ScannedMealInstance.MealInstanceId">
                        <button type="submit" class="btn btn-primary btn-sm">Eat</button>
                    </form>
                </div>
                <table class="table mb-0 table-cards">
                    <tbody>
                        <tr>
                            <td data-label="Location">@Model.ScannedMealInstance.Meal?.Location?.Name</td>
                            <td data-label="Expiry">
                                @{
                                    int? daysUntilExpiry = IndexModel.GetDaysUntilExpiry(Model.ScannedMealInstance.Meal?.Expiry);
                                    string? expiryBadgeClass = IndexModel.GetExpiryBadgeClass(daysUntilExpiry);
                                }
                                @if (expiryBadgeClass is not null)
                                {
                                    <span class="@expiryBadgeClass">@IndexModel.FormatDaysUntilExpiry(daysUntilExpiry)</span>
                                }
                                else
                                {
                                    @IndexModel.FormatDaysUntilExpiry(daysUntilExpiry)
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model.ScannedItem is not null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h4 mb-0">@Model.ScannedItemTitle</h2>
                    <div>
                        <a asp-page="/Stock/Add" asp-route-barcode="@Model.Barcode" class="btn btn-primary btn-sm"><partial name="_Icon" model="@("plus-lg")" />Add Stock</a>
                        <a asp-page="/Manage/Items/Edit" asp-route-id="@Model.ScannedItem.ItemId" class="btn btn-outline-secondary btn-sm"><partial name="_Icon" model="@("pencil")" />Edit Item</a>
                    </div>
                </div>

                @if (Model.ScannedItemStock.Count == 0)
                {
                    <p class="mb-0">No stock currently held for this item.</p>
                }
                else
                {
                    <table class="table mb-0 table-cards">
                        <tbody>
                            @foreach (StockWise.Models.Stock stock in Model.ScannedItemStock)
                            {
                                <tr>
                                    <td data-label="Type">@Model.ScannedItem.Type?.Name</td>
                                    <td data-label="Location">@stock.Location?.Name</td>
                                    <td data-label="Quantity">@stock.Quantity</td>
                                    <td data-label="Expiry">
                                        @{
                                            int? daysUntilExpiry = IndexModel.GetDaysUntilExpiry(stock.Expiry);
                                            string? expiryBadgeClass = IndexModel.GetExpiryBadgeClass(daysUntilExpiry);
                                        }
                                        @if (expiryBadgeClass is not null)
                                        {
                                            <span class="@expiryBadgeClass">@IndexModel.FormatDaysUntilExpiry(daysUntilExpiry)</span>
                                        }
                                        else
                                        {
                                            @IndexModel.FormatDaysUntilExpiry(daysUntilExpiry)
                                        }
                                    </td>
                                    <td data-label="Opened">
                                        @if (Model.ScannedItem.IsOpenable)
                                        {
                                            @if (stock.OpenedAt is not null)
                                            {
                                                <span class="tile tile-green tile-icon"><partial name="_Icon" model="@("check-lg")" /></span>
                                            }
                                            else
                                            {
                                                <span class="tile tile-red tile-icon"><partial name="_Icon" model="@("x-lg")" /></span>
                                            }
                                        }
                                    </td>
                                    <td class="action-cell">
                                        @if (Model.ScannedItem.IsOpenable && stock.OpenedAt is null)
                                        {
                                            <a asp-page="/Stock/Open" asp-route-id="@stock.StockId" class="btn-icon" title="Open" aria-label="Open"><partial name="_Icon" model="@("unlock")" /></a>
                                        }
                                    </td>
                                    <td class="action-cell">
                                        <form method="post" asp-page-handler="Checkout" asp-route-stockId="@stock.StockId" asp-route-barcode="@Model.Barcode" class="d-inline">
                                            <button type="submit" class="btn-icon" title="Checkout 1" aria-label="Checkout 1">1</button>
                                        </form>
                                    </td>
                                    <td class="action-cell">
                                        @if (stock.Quantity > 1)
                                        {
                                            <span class="checkout-multi d-inline-block position-relative">
                                                <button type="button" class="btn-icon checkout-multi-toggle" title="Checkout multiple" aria-label="Checkout multiple">#</button>
                                                <form method="post" asp-page-handler="CheckoutMultiple" asp-route-stockId="@stock.StockId" asp-route-barcode="@Model.Barcode" class="checkout-multi-form d-none align-items-center gap-2">
                                                    <input type="number" name="quantity" min="1" max="@stock.Quantity" value="@stock.Quantity" class="form-control form-control-sm" />
                                                    <button type="submit" class="btn btn-primary btn-sm">Go</button>
                                                </form>
                                            </span>
                                        }
                                    </td>
                                    <td class="action-cell">
                                        @if (stock.OpenedAt is not null)
                                        {
                                            <form method="post" asp-page-handler="Finish" asp-route-stockId="@stock.StockId" asp-route-barcode="@Model.Barcode" class="d-inline">
                                                <button type="submit" class="btn-icon" title="Finish" aria-label="Finish"><partial name="_Icon" model="@("check2-circle")" /></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}

@if (Model.AvailableTypeNames.Count > 0)
{
    <div class="filter-bar mb-3">
        <a href="@Model.BuildFilterUrl(null)" class="filter-btn @(Model.Types.Count == 0 ? "filter-btn-active" : "")">Reset</a>
        @foreach (string typeName in Model.AvailableTypeNames)
        {
            <a href="@Model.BuildFilterUrl(typeName)" class="filter-btn @(Model.Types.Contains(typeName) ? "filter-btn-active" : "")">@typeName</a>
        }
    </div>
}

@if (Model.AllRows.Count == 0)
{
    <p>No stock currently held.</p>
}
else
{
    <table class="table table-cards table-cards-grid">
        <thead>
            <tr>
                <th><a href="@Model.BuildSortUrl("item")" class="text-decoration-none">Item@(Model.Sort == "item" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a href="@Model.BuildSortUrl("brand")" class="text-decoration-none">Brand@(Model.Sort == "brand" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a href="@Model.BuildSortUrl("type")" class="text-decoration-none">Type@(Model.Sort == "type" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a href="@Model.BuildSortUrl("location")" class="text-decoration-none">Location@(Model.Sort == "location" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a href="@Model.BuildSortUrl("quantity")" class="text-decoration-none">Quantity@(Model.Sort == "quantity" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a href="@Model.BuildSortUrl("expiry")" class="text-decoration-none">Expiry@(Model.Sort == "expiry" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a href="@Model.BuildSortUrl("opened")" class="text-decoration-none">Opened@(Model.Sort == "opened" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (IInventoryRow row in Model.AllRows)
            {
                <tr class="category-row" style="--cat-color: @(row.CategoryColor ?? "#6c757d");">
                    <td class="cell-heading">@row.Name</td>
                    <td data-label="Brand">@row.Brand</td>
                    <td data-label="Type">@row.TypeName</td>
                    <td data-label="Location">@row.LocationName</td>
                    <td data-label="Quantity">@row.Quantity</td>
                    <td data-label="Expiry">
                        @{
                            int? daysUntilExpiry = IndexModel.GetDaysUntilExpiry(row.Expiry);
                            string? expiryBadgeClass = IndexModel.GetExpiryBadgeClass(daysUntilExpiry);
                        }
                        @if (expiryBadgeClass is not null)
                        {
                            <span class="@expiryBadgeClass">@IndexModel.FormatDaysUntilExpiry(daysUntilExpiry)</span>
                        }
                        else
                        {
                            @IndexModel.FormatDaysUntilExpiry(daysUntilExpiry)
                        }
                    </td>
                    <td data-label="Opened">
                        @if (row is StockRow openedStockRow && openedStockRow.Stock.Item is not null && openedStockRow.Stock.Item.IsOpenable)
                        {
                            @if (openedStockRow.Stock.OpenedAt is not null)
                            {
                                <span class="tile tile-green tile-icon"><partial name="_Icon" model="@("check-lg")" /></span>
                            }
                            else
                            {
                                <span class="tile tile-red tile-icon"><partial name="_Icon" model="@("x-lg")" /></span>
                            }
                        }
                    </td>
                    <td class="action-cell">
                        @if (row is StockRow stockRow)
                        {
                            @if (stockRow.Stock.Item is not null && stockRow.Stock.Item.IsOpenable && stockRow.Stock.OpenedAt is null)
                            {
                                <a asp-page="/Stock/Open" asp-route-id="@stockRow.Stock.StockId" class="btn-icon" title="Open" aria-label="Open"><partial name="_Icon" model="@("unlock")" /></a>
                            }
                            else
                            {
                                <span class="btn-icon btn-icon-placeholder" aria-hidden="true"></span>
                            }
                            <form method="post" asp-page-handler="Checkout" asp-route-stockId="@stockRow.Stock.StockId" class="d-inline">
                                <button type="submit" class="btn-icon" title="Checkout 1" aria-label="Checkout 1">1</button>
                            </form>
                            @if (stockRow.Stock.Quantity > 1)
                            {
                                <span class="checkout-multi d-inline-block position-relative">
                                    <button type="button" class="btn-icon checkout-multi-toggle" title="Checkout multiple" aria-label="Checkout multiple">#</button>
                                    <form method="post" asp-page-handler="CheckoutMultiple" asp-route-stockId="@stockRow.Stock.StockId" class="checkout-multi-form d-none align-items-center gap-2">
                                        <input type="number" name="quantity" min="1" max="@stockRow.Stock.Quantity" value="@stockRow.Stock.Quantity" class="form-control form-control-sm" />
                                        <button type="submit" class="btn btn-primary btn-sm">Go</button>
                                    </form>
                                </span>
                            }
                            else
                            {
                                <span class="btn-icon btn-icon-placeholder" aria-hidden="true"></span>
                            }
                            @if (stockRow.Stock.OpenedAt is not null)
                            {
                                <form method="post" asp-page-handler="Finish" asp-route-stockId="@stockRow.Stock.StockId" class="d-inline">
                                    <button type="submit" class="btn-icon" title="Finish" aria-label="Finish"><partial name="_Icon" model="@("check2-circle")" /></button>
                                </form>
                            }
                            else
                            {
                                <span class="btn-icon btn-icon-placeholder" aria-hidden="true"></span>
                            }
                        }
                        else if (row is MealRow mealRow)
                        {
                            <span class="btn-icon btn-icon-placeholder" aria-hidden="true"></span>
                            <form method="post" asp-page-handler="Eat" asp-route-mealInstanceId="@mealRow.Meal.Instances[0].MealInstanceId" class="d-inline">
                                <button type="submit" class="btn-icon" title="Eat" aria-label="Eat">Eat</button>
                            </form>
                            <span class="btn-icon btn-icon-placeholder" aria-hidden="true"></span>
                            <span class="btn-icon btn-icon-placeholder" aria-hidden="true"></span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
