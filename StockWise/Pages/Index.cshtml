@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<form method="get" class="mb-4">
    <div class="mb-3">
        <input asp-for="Barcode" class="form-control" autofocus autocomplete="off" />
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Barcode))
{
    @if (Model.ScannedItem is null)
    {
        <div class="alert alert-warning">
            No item found for barcode "@Model.Barcode".
            <a asp-page="/Manage/Items/Add" asp-route-barcode="@Model.Barcode">Add new item</a>
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h4 mb-0">@Model.ScannedItem.Name</h2>
                    <div>
                        <a asp-page="/Stock/Add" asp-route-barcode="@Model.Barcode" class="btn btn-primary btn-sm">Add stock</a>
                        <a asp-page="/Manage/Items/Edit" asp-route-id="@Model.ScannedItem.ItemId" class="btn btn-outline-secondary btn-sm">Edit item</a>
                    </div>
                </div>

                @if (Model.ScannedItemStock.Count == 0)
                {
                    <p class="mb-0">No stock currently held for this item.</p>
                }
                else
                {
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Location</th>
                                <th>Quantity</th>
                                <th>Expiry</th>
                                <th>Opened</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (StockWise.Models.Stock stock in Model.ScannedItemStock)
                            {
                                <tr>
                                    <td>@stock.Location?.Name</td>
                                    <td>@stock.Quantity</td>
                                    <td>@stock.Expiry</td>
                                    <td>@(stock.OpenedAt is not null ? "Yes" : "No")</td>
                                    <td>
                                        <form method="post" asp-page-handler="Checkout" asp-route-stockId="@stock.StockId" asp-route-barcode="@Model.Barcode" class="d-inline">
                                            <button type="submit" class="btn btn-outline-secondary btn-sm">Checkout 1</button>
                                        </form>
                                        @if (Model.ScannedItem.IsOpenable && stock.OpenedAt is null)
                                        {
                                            <a asp-page="/Stock/Open" asp-route-id="@stock.StockId" class="btn btn-outline-secondary btn-sm">Open</a>
                                        }
                                        @if (stock.OpenedAt is not null)
                                        {
                                            <form method="post" asp-page-handler="Finish" asp-route-stockId="@stock.StockId" asp-route-barcode="@Model.Barcode" class="d-inline">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm">Finish</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}

@if (Model.AllStock.Count == 0)
{
    <p>No stock currently held.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th><a asp-page="/Index" asp-route-sort="item" asp-route-direction="@(Model.Sort == "item" && Model.Direction == "asc" ? "desc" : "asc")" asp-route-barcode="@Model.Barcode" class="text-decoration-none">Item@(Model.Sort == "item" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a asp-page="/Index" asp-route-sort="location" asp-route-direction="@(Model.Sort == "location" && Model.Direction == "asc" ? "desc" : "asc")" asp-route-barcode="@Model.Barcode" class="text-decoration-none">Location@(Model.Sort == "location" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a asp-page="/Index" asp-route-sort="quantity" asp-route-direction="@(Model.Sort == "quantity" && Model.Direction == "asc" ? "desc" : "asc")" asp-route-barcode="@Model.Barcode" class="text-decoration-none">Quantity@(Model.Sort == "quantity" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a asp-page="/Index" asp-route-sort="expiry" asp-route-direction="@(Model.Sort == "expiry" && Model.Direction == "asc" ? "desc" : "asc")" asp-route-barcode="@Model.Barcode" class="text-decoration-none">Expiry@(Model.Sort == "expiry" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a asp-page="/Index" asp-route-sort="opened" asp-route-direction="@(Model.Sort == "opened" && Model.Direction == "asc" ? "desc" : "asc")" asp-route-barcode="@Model.Barcode" class="text-decoration-none">Opened@(Model.Sort == "opened" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (StockWise.Models.Stock stock in Model.AllStock)
            {
                <tr class="category-row" style="--cat-color: @(stock.Location?.Category?.Color ?? "#6c757d");">
                    <td>@stock.Item?.Name</td>
                    <td>@stock.Location?.Name</td>
                    <td>@stock.Quantity</td>
                    <td>@stock.Expiry</td>
                    <td>@(stock.OpenedAt is not null ? "Yes" : "No")</td>
                    <td>
                        <form method="post" asp-page-handler="Checkout" asp-route-stockId="@stock.StockId" class="d-inline">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Checkout 1</button>
                        </form>
                        @if (stock.Item is not null && stock.Item.IsOpenable && stock.OpenedAt is null)
                        {
                            <a asp-page="/Stock/Open" asp-route-id="@stock.StockId" class="btn btn-outline-secondary btn-sm">Open</a>
                        }
                        @if (stock.OpenedAt is not null)
                        {
                            <form method="post" asp-page-handler="Finish" asp-route-stockId="@stock.StockId" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Finish</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}