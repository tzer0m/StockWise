@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<form method="get" class="mb-4">
    <div class="mb-3">
        <input asp-for="Barcode" class="form-control" autofocus autocomplete="off" placeholder="Scan a barcode..." />
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Barcode))
{
    @if (Model.ScannedItem is null)
    {
        <div class="alert alert-warning">
            "@Model.Barcode" not found.
            <a asp-page="/Manage/Items/Add" asp-route-barcode="@Model.Barcode">Add</a>
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h4 mb-0">@Model.ScannedItem.Name</h2>
                    <div>
                        <a asp-page="/Stock/Add" asp-route-barcode="@Model.Barcode" class="btn btn-primary btn-sm"><partial name="_Icon" model="@("plus-lg")" />Add Stock</a>
                        <a asp-page="/Manage/Items/Edit" asp-route-id="@Model.ScannedItem.ItemId" class="btn btn-outline-secondary btn-sm"><partial name="_Icon" model="@("pencil")" />Edit Item</a>
                    </div>
                </div>

                @if (Model.ScannedItemStock.Count == 0)
                {
                    <p class="mb-0">No stock currently held for this item.</p>
                }
                else
                {
                    <table class="table mb-0 table-cards">
                        <thead>
                            <tr>
                                <th>Location</th>
                                <th>Quantity</th>
                                <th>Expiry</th>
                                <th>Opened</th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (StockWise.Models.Stock stock in Model.ScannedItemStock)
                            {
                                <tr>
                                    <td data-label="Location">@stock.Location?.Name</td>
                                    <td data-label="Quantity">@stock.Quantity</td>
                                    <td data-label="Expiry">@stock.Expiry</td>
                                    <td data-label="Opened">@(stock.OpenedAt is not null ? "Yes" : "No")</td>
                                    <td class="action-cell">
                                        @if (Model.ScannedItem.IsOpenable && stock.OpenedAt is null)
                                        {
                                            <a asp-page="/Stock/Open" asp-route-id="@stock.StockId" class="btn-icon" title="Open" aria-label="Open"><partial name="_Icon" model="@("unlock")" /></a>
                                        }
                                    </td>
                                    <td class="action-cell">
                                        <form method="post" asp-page-handler="Checkout" asp-route-stockId="@stock.StockId" asp-route-barcode="@Model.Barcode" class="d-inline">
                                            <button type="submit" class="btn-icon" title="Checkout 1" aria-label="Checkout 1"><partial name="_Icon" model="@("dash-circle")" /></button>
                                        </form>
                                    </td>
                                    <td class="action-cell">
                                        @if (stock.OpenedAt is not null)
                                        {
                                            <form method="post" asp-page-handler="Finish" asp-route-stockId="@stock.StockId" asp-route-barcode="@Model.Barcode" class="d-inline">
                                                <button type="submit" class="btn-icon" title="Finish" aria-label="Finish"><partial name="_Icon" model="@("check2-circle")" /></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}

@if (Model.AllStock.Count == 0)
{
    <p>No stock currently held.</p>
}
else
{
    <table class="table table-cards table-cards-grid">
        <thead>
            <tr>
                <th><a asp-page="/Index" asp-route-sort="item" asp-route-direction="@(Model.Sort == "item" && Model.Direction == "asc" ? "desc" : "asc")" asp-route-barcode="@Model.Barcode" class="text-decoration-none">Item@(Model.Sort == "item" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a asp-page="/Index" asp-route-sort="brand" asp-route-direction="@(Model.Sort == "brand" && Model.Direction == "asc" ? "desc" : "asc")" asp-route-barcode="@Model.Barcode" class="text-decoration-none">Brand@(Model.Sort == "brand" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a asp-page="/Index" asp-route-sort="location" asp-route-direction="@(Model.Sort == "location" && Model.Direction == "asc" ? "desc" : "asc")" asp-route-barcode="@Model.Barcode" class="text-decoration-none">Location@(Model.Sort == "location" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a asp-page="/Index" asp-route-sort="quantity" asp-route-direction="@(Model.Sort == "quantity" && Model.Direction == "asc" ? "desc" : "asc")" asp-route-barcode="@Model.Barcode" class="text-decoration-none">Quantity@(Model.Sort == "quantity" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a asp-page="/Index" asp-route-sort="expiry" asp-route-direction="@(Model.Sort == "expiry" && Model.Direction == "asc" ? "desc" : "asc")" asp-route-barcode="@Model.Barcode" class="text-decoration-none">Expiry@(Model.Sort == "expiry" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th><a asp-page="/Index" asp-route-sort="opened" asp-route-direction="@(Model.Sort == "opened" && Model.Direction == "asc" ? "desc" : "asc")" asp-route-barcode="@Model.Barcode" class="text-decoration-none">Opened@(Model.Sort == "opened" ? (Model.Direction == "asc" ? " ▲" : " ▼") : "")</a></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (StockWise.Models.Stock stock in Model.AllStock)
            {
                <tr class="category-row" style="--cat-color: @(stock.Location?.Category?.Color ?? "#6c757d");">
                    <td class="cell-heading">@stock.Item?.Name</td>
                    <td data-label="Brand">@stock.Item?.Brand</td>
                    <td data-label="Location">@stock.Location?.Name</td>
                    <td data-label="Quantity">@stock.Quantity</td>
                    <td data-label="Expiry">
                        @{
                            int? daysUntilExpiry = IndexModel.GetDaysUntilExpiry(stock.Expiry);
                            string? expiryBadgeClass = IndexModel.GetExpiryBadgeClass(daysUntilExpiry);
                        }
                        @if (expiryBadgeClass is not null)
                        {
                            <span class="@expiryBadgeClass">@IndexModel.FormatDaysUntilExpiry(daysUntilExpiry)</span>
                        }
                        else
                        {
                            @IndexModel.FormatDaysUntilExpiry(daysUntilExpiry)
                        }
                    </td>
                    <td data-label="Opened">
                        @if (stock.Item is not null && stock.Item.IsOpenable)
                        {
                            @if (stock.OpenedAt is not null)
                            {
                                <span class="tile tile-green tile-icon"><partial name="_Icon" model="@("check-lg")" /></span>
                            }
                            else
                            {
                                <span class="tile tile-red tile-icon"><partial name="_Icon" model="@("x-lg")" /></span>
                            }
                        }
                    </td>
                    <td class="action-cell">
                        @if (stock.Item is not null && stock.Item.IsOpenable && stock.OpenedAt is null)
                        {
                            <a asp-page="/Stock/Open" asp-route-id="@stock.StockId" class="btn-icon" title="Open" aria-label="Open"><partial name="_Icon" model="@("unlock")" /></a>
                        }
                        <form method="post" asp-page-handler="Checkout" asp-route-stockId="@stock.StockId" class="d-inline">
                            <button type="submit" class="btn-icon" title="Checkout 1" aria-label="Checkout 1"><partial name="_Icon" model="@("dash-circle")" /></button>
                        </form>
                        @if (stock.OpenedAt is not null)
                        {
                            <form method="post" asp-page-handler="Finish" asp-route-stockId="@stock.StockId" class="d-inline">
                                <button type="submit" class="btn-icon" title="Finish" aria-label="Finish"><partial name="_Icon" model="@("check2-circle")" /></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}